# The apt repository of Apache SkyWalking AI Sessionizer. The apt skill in
# apache/skywalking-ai-sessionizer writes this file from the Packages files.
# apt asks for each package under pool/, and each rule sends it to the voted
# file: the newest version through the mirrors, every older one to the archive.
RewriteEngine On
RewriteRule ^pool/asz-claude-code_0\.4\.0_amd64\.deb$ https://www.apache.org/dyn/closer.lua/skywalking/ai-sessionizer/0.4.0/apache-skywalking-ai-sessionizer-0.4.0-bin-asz-claude-code-amd64.deb?action=download [R=302,L]
RewriteRule ^pool/asz-claude-code_0\.4\.0_arm64\.deb$ https://www.apache.org/dyn/closer.lua/skywalking/ai-sessionizer/0.4.0/apache-skywalking-ai-sessionizer-0.4.0-bin-asz-claude-code-arm64.deb?action=download [R=302,L]
RewriteRule ^pool/asz_0\.4\.0_amd64\.deb$ https://www.apache.org/dyn/closer.lua/skywalking/ai-sessionizer/0.4.0/apache-skywalking-ai-sessionizer-0.4.0-bin-asz-amd64.deb?action=download [R=302,L]
RewriteRule ^pool/asz_0\.4\.0_arm64\.deb$ https://www.apache.org/dyn/closer.lua/skywalking/ai-sessionizer/0.4.0/apache-skywalking-ai-sessionizer-0.4.0-bin-asz-arm64.deb?action=download [R=302,L]
