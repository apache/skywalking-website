ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header set Content-Security-Policy "frame-src 'self' https://www.google.com https://app.netlify.com"

    # The 3D-map SPA assets are content-hashed by Vite (e.g. index-CZkrbiDB.js),
    # so they are immutable and safe to cache forever.
    <If "%{REQUEST_URI} =~ m#^/3d-map-app/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>